# Solo los nombres. Los valores se cargan en Vercel (Settings → Environment Variables),
# nunca en el repo ni en el chat. Para probar en local: copiar a .env.local (ignorado por git).

# IA
ANTHROPIC_API_KEY=

# Chatwoot (la bandeja central, en el servidor de DonWeb)
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Supabase: las crea solas la integración de Supabase en Vercel (Storage / Marketplace)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CRM del hub (Google Sheets), con una cuenta de servicio propia del asistente
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CRM_SHEET_ID=

# Seguimientos (cron)
CRON_SECRET=

# Opcionales (ver docs/asistente.md)
# ASISTENTE_MODELO=claude-opus-5-5
# ASISTENTE_ESFUERZO=medium
# CRM_RESPONSABLE=
