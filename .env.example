# Solo los nombres. Los valores se cargan en Vercel (Settings → Environment Variables),
# nunca en el repo ni en el chat. Para probar en local: copiar a .env.local (ignorado por git).

# IA: hoy responde Claude. OPENAI_API_KEY (opcional) transcribe los audios, o responde si no hay ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Chatwoot (la bandeja central, en el servidor de Hostinger)
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Base (Postgres en Neon): la carga sola la integración de Neon en Vercel.
# DATABASE_URL_UNPOOLED, si está, se usa para aplicar las migraciones.
DATABASE_URL=

# CRM del hub (Google Sheets), con una cuenta de servicio propia del asistente
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
CRM_SHEET_ID=

# Seguimientos (el cron de Vercel manda esta clave)
CRON_SECRET=

# Panel (/panel): la clave para entrar
PANEL_CLAVE=

# Opcional: la clave que comparte el asistente con el hub de Mindlin, para que el hub lea y cambie
# la configuración (docs/api-hub.md). Sin ella, esa API está apagada.
# HUB_CLAVE=

# Opcionales (ver docs/asistente.md)
# ASISTENTE_PROVEEDOR=openai        # o anthropic; si no está, el que tenga clave (con las dos, anthropic)
# ASISTENTE_MODELO=                 # por defecto gpt-6.1-sol con OpenAI o claude-opus-5-5 con Anthropic
# ASISTENTE_ESFUERZO=medium
# ASISTENTE_MODELO_AUDIOS=gpt-transcribe
# CRM_RESPONSABLE=
