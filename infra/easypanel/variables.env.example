# Pestaña «Entorno» del servicio Compose en Easypanel, con «Crear archivo .env» prendido.
# Solo los nombres: los valores se generan en el servidor (ver docs/easypanel.md) y no se copian a ningún chat.
DOMINIO_CHAT=chat.mindlindevelopers.com
DOMINIO_WAHA=waha.mindlindevelopers.com
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY_BASE=
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=
# Con 8 GB de RAM o más (KVM 2): 5 y 10
RAILS_MAX_THREADS=3
SIDEKIQ_CONCURRENCY=5
